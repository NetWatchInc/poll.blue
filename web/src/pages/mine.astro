---
import Base from "../layouts/Base.astro";
import MyPolls from "../components/MyPolls.tsx";
import { site } from "../lib/site";

const { mine } = site;
---

<Base title={mine.title}>
  <section class="mx-auto max-w-2xl px-6 pt-8 pb-20">
    <div class="mb-8">
      <h1 class="text-4xl sm:text-5xl">{mine.heading}</h1>
      <p class="mt-3 text-lg text-[var(--color-ink-soft)]">
        {mine.subtitle}
      </p>
    </div>
    <MyPolls client:only="preact" />
  </section>
</Base>
