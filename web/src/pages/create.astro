---
import Base from "../layouts/Base.astro";
import CreatePoll from "../components/CreatePoll.tsx";
import { site } from "../lib/site";

const { create } = site;
---

<Base title={create.title} description={create.description}>
  <section class="mx-auto max-w-5xl px-6 pt-8 pb-20">
    <div class="mb-8 max-w-xl">
      <h1 class="text-4xl sm:text-5xl">{create.heading}</h1>
      <p class="mt-3 text-lg text-[var(--color-ink-soft)]">
        {create.subtitle}
      </p>
    </div>
    <CreatePoll client:only="preact" />
  </section>
</Base>
